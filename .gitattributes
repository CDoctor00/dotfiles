# .gitattributes — GitHub Linguist overrides
# Controls how GitHub detects and displays languages in the repo stats.
# https://github.com/github-linguist/linguist

# ── Rofi ──────────────────────────────────────────────────────────────────────
# .rasi files are Rofi theme files with CSS-like syntax.
*.rasi linguist-language=CSS linguist-detectable=true

# ── Config files ──────────────────────────────────────────────────────────────
# Linguist to include these files in the language stats.
*.conf linguist-language=INI linguist-detectable=true
*.ini  linguist-language=INI linguist-detectable=true

# ── Hyprland configs ──────────────────────────────────────────────────────────
# Hyprland uses an INI-like syntax, not Shell.
configs/hypr/.config/hypr/hyprland.conf  linguist-language=INI linguist-detectable=true
configs/hypr/.config/hypr/hyprpaper.conf linguist-language=INI linguist-detectable=true
configs/hypr/.config/hypr/hyprlock.conf  linguist-language=INI linguist-detectable=true
configs/hypr/.config/hypr/hypridle.conf  linguist-language=INI linguist-detectable=true

# ── Extensionless files ────────────────────────────────────────────────────────
configs/dunst/.config/dunst/dunstrc        linguist-language=INI  linguist-detectable=true
configs/waybar/.config/waybar/config       linguist-language=JSON linguist-detectable=true
system/sddm-theme/silent/metadata.desktop  linguist-language=INI  linguist-detectable=true

# ── Documentation and assets ──────────────────────────────────────────────────
# Exclude non-code files from language stats.
packages/packages.txt      linguist-documentation=true
packages/aur-packages.txt  linguist-documentation=true
scripts/system-files.conf  linguist-documentation=true
docs/*                     linguist-documentation=true
assets/*                   linguist-documentation=true