{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-icat",
    "source": "/home/cdoctor/.dotfiles/assets/images/astronaut_1.png",
    "width": 60,
    "padding": {
      "top": 0,
      "right": 5,
    },
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 25,
    },
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;208;135;112",
        "at": "38;2;216;222;233",
        "host": "38;2;235;203;139",
      },
    },
    "separator",
    {
      "type": "custom",
      "format": "{##88C0D0}󰇅 HARDWARE{#}",
    },
    {
      "type": "host",
      "key": "│ ├   Host",
      "keyColor": "38;2;136;192;208",
    },
    {
      "type": "cpu",
      "key": "│ ├   CPU",
      "keyColor": "38;2;136;192;208",
    },
    {
      "type": "gpu",
      "key": "│ ├ 󰢮  GPU",
      "keyColor": "38;2;136;192;208",
    },
    {
      "type": "memory",
      "key": "│ ├   Memory",
      "keyColor": "38;2;136;192;208",
    },
    {
      "type": "disk",
      "key": "│ ├ 󰋊  Disk",
      "keyColor": "38;2;136;192;208",
    },
    {
      "type": "display",
      "key": "│ └   Monitor",
      "keyColor": "38;2;136;192;208",
    },
    "break",
    {
      "type": "custom",
      "format": "{##81A1C1}󱃷 SOFTWARE{#}",
    },
    {
      "type": "os",
      "key": "│ ├   OS",
      "keyColor": "38;2;129;161;193",
    },
    {
      "type": "kernel",
      "key": "│ ├   Kernel",
      "keyColor": "38;2;129;161;193",
    },
    {
      "type": "packages",
      "key": "│ ├ 󰏖  Packages",
      "keyColor": "38;2;129;161;193",
    },
    {
      "type": "shell",
      "key": "│ ├   Shell",
      "keyColor": "38;2;129;161;193",
    },
    {
      "type": "localip",
      "key": "│ ├ 󰩟  Local IP",
      "keyColor": "38;2;129;161;193",
      "showIpv4": true,
    },
    {
      "type": "publicip",
      "key": "│ ├   Public IP",
      "keyColor": "38;2;129;161;193",
    },
    {
      "type": "uptime",
      "key": "│ └   Uptime",
      "keyColor": "38;2;129;161;193",
    },
    "break",
    {
      "type": "custom",
      "format": "{##5E81AC}󰹑 ENVIRONMENT{#}",
    },
    {
      "type": "wm",
      "key": "│ ├   Window Mgr",
      "keyColor": "38;2;94;129;172",
    },
    {
      "type": "lm",
      "key": "│ ├   Login Mgr",
      "keyColor": "38;2;94;129;172",
    },
    {
      "type": "theme",
      "key": "│ ├   DE Theme",
      "keyColor": "38;2;94;129;172",
    },
    {
      "type": "custom",
      "key": "│ ├   Color Theme",
      "keyColor": "38;2;94;129;172",
      "format": "Nord palette",
    },
    {
      "type": "icons",
      "key": "│ ├   Icons",
      "keyColor": "38;2;94;129;172",
    },
    {
      "type": "font",
      "key": "│ ├   Font",
      "keyColor": "38;2;94;129;172",
    },
    {
      "type": "cursor",
      "key": "│ ├   Cursor",
      "keyColor": "38;2;94;129;172",
    },
    {
      "type": "locale",
      "key": "│ ├ 󰗊  Locale",
      "keyColor": "38;2;94;129;172",
    },
    {
      "type": "terminal",
      "key": "│ └   Terminal",
      "keyColor": "38;2;94;129;172",
    },
    "break",
    {
      "type": "custom",
      "format": "             {##2E3440}●{#} {##3B4252}●{#} {##434C5E}●{#} {##4C566A}●{#}  {##D8DEE9}●{#} {##E5E9F0}●{#} {##ECEFF4}●{#}  {##8FBCBB}●{#} {##88C0D0}●{#} {##81A1C1}●{#} {##5E81AC}●{#}  {##B48EAD}●{#} {##BF616A}●{#} {##D08770}●{#} {##EBCB8B}●{#} {##A3BE8C}●{#}",
    },
  ],
}
